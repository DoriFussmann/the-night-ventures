# Public (Vite) — safe to expose in the browser
VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only (Vercel / vercel dev) — never prefix with VITE_
SUPABASE_URL=your-project-url-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
UNSPLASH_ACCESS_KEY=
SHUTTERSTOCK_API_TOKEN=
SHUTTERSTOCK_SUBSCRIPTION_ID=
IMAGE_STOCK_ORDER=unsplash,shutterstock
IMAGE_STOCK_MIN_SCORE=7
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=The Night Ventures <onboarding@resend.dev>
INQUIRY_TO_EMAIL=dori@thenightventures.com
DATAFORSEO_LOGIN=your-dataforseo-login-here
DATAFORSEO_PASSWORD=your-dataforseo-password-here
SEMRUSH_API_KEY=your-semrush-api-key-here
MOZ_API_TOKEN=your-moz-api-token-here
# SEO Advisor data agent model (optional; default claude-haiku-4-5-20251001)
SEO_ROUTER_MODEL=
GOOGLE_PAGESPEED_API_KEY=your-google-pagespeed-api-key-here

# Publish to Site — one fine-grained PAT per destination site.
# Name matches companies.github_token_key: GITHUB_TOKEN_<KEY>
# (Contents + Pull requests on that company's GitHub repo)
GITHUB_TOKEN_TEMPLATE=github_pat_your-fine-grained-token
