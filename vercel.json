{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/check-article-update",
      "has": [
        {
          "type": "query",
          "key": "action",
          "value": "scan-live"
        }
      ],
      "destination": "/api/scan-live-articles"
    },
    {
      "source": "/api/check-article-update",
      "has": [
        {
          "type": "query",
          "key": "action",
          "value": "publish-to-site"
        }
      ],
      "destination": "/api/publish-to-site"
    },
    {
      "source": "/api/check-article-update",
      "has": [
        {
          "type": "query",
          "key": "action",
          "value": "wire-internal-links"
        }
      ],
      "destination": "/api/wire-internal-links"
    },
    {
      "source": "/api/check-article-update",
      "has": [
        {
          "type": "query",
          "key": "action",
          "value": "propose-external-links"
        }
      ],
      "destination": "/api/propose-external-links"
    },
    {
      "source": "/api/check-article-update",
      "has": [
        {
          "type": "query",
          "key": "action",
          "value": "check-links"
        }
      ],
      "destination": "/api/check-links"
    },
    {
      "source": "/api/check-article-update",
      "has": [
        {
          "type": "query",
          "key": "action",
          "value": "article-updates"
        }
      ],
      "destination": "/api/article-updates"
    },
    {
      "source": "/api/check-article-update",
      "has": [
        {
          "type": "query",
          "key": "action",
          "value": "company-data-import"
        }
      ],
      "destination": "/api/company-data-import"
    },
    {
      "source": "/api/check-article-update",
      "has": [
        {
          "type": "query",
          "key": "action",
          "value": "audit-summary"
        }
      ],
      "destination": "/api/audit-summary"
    },
    {
      "source": "/api/check-article-update",
      "has": [
        {
          "type": "query",
          "key": "action",
          "value": "core-version"
        }
      ],
      "destination": "/api/core-version"
    },
    {
      "source": "/api/check-article-update",
      "has": [
        {
          "type": "query",
          "key": "action",
          "value": "instantly"
        }
      ],
      "destination": "/api/instantly"
    },
    {
      "source": "/api/check-article-update",
      "has": [
        {
          "type": "query",
          "key": "action",
          "value": "instantly-webhook"
        }
      ],
      "destination": "/api/instantly-webhook"
    },
    {
      "source": "/api/check-article-update",
      "has": [
        {
          "type": "query",
          "key": "action",
          "value": "integrations"
        }
      ],
      "destination": "/api/integrations"
    },
    {
      "source": "/api/check-article-update",
      "has": [
        {
          "type": "query",
          "key": "action",
          "value": "suggest-target-keyword"
        }
      ],
      "destination": "/api/suggest-target-keyword"
    },
    {
      "source": "/api/check-article-update",
      "has": [
        {
          "type": "query",
          "key": "action",
          "value": "site-placeholders"
        }
      ],
      "destination": "/api/site-placeholders"
    },
    {
      "source": "/api/check-article-update",
      "has": [
        {
          "type": "query",
          "key": "action",
          "value": "publish-schedule"
        }
      ],
      "destination": "/api/publish-schedule"
    },
    {
      "source": "/api/check-article-update",
      "has": [
        {
          "type": "query",
          "key": "action",
          "value": "audience-build"
        }
      ],
      "destination": "/api/audience-build"
    },
    {
      "source": "/api/check-article-update",
      "has": [
        {
          "type": "query",
          "key": "action",
          "value": "analyze-writer-article"
        }
      ],
      "destination": "/api/analyze-writer-article"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/audit-snapshot",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/publish-schedule",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/audience-build",
      "schedule": "0 11 * * 1"
    },
    {
      "path": "/api/audience-build?job=daily-pull",
      "schedule": "0 12 * * 1-5"
    }
  ],
  "functions": {
    "api/audience-build.js": {
      "includeFiles": "lib/audience-build/data/**"
    }
  }
}
