{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/scan-live-articles",
      "destination": "/api/check-article-update?action=scan-live"
    },
    {
      "source": "/api/publish-to-site",
      "destination": "/api/check-article-update?action=publish-to-site"
    },
    {
      "source": "/api/wire-internal-links",
      "destination": "/api/check-article-update?action=wire-internal-links"
    },
    {
      "source": "/api/propose-external-links",
      "destination": "/api/check-article-update?action=propose-external-links"
    },
    {
      "source": "/api/check-links",
      "destination": "/api/check-article-update?action=check-links"
    },
    {
      "source": "/api/article-updates",
      "destination": "/api/check-article-update?action=article-updates"
    },
    {
      "source": "/api/company-data-import",
      "destination": "/api/check-article-update?action=company-data-import"
    },
    {
      "source": "/api/audit-summary",
      "destination": "/api/check-article-update?action=audit-summary"
    },
    {
      "source": "/api/core-version",
      "destination": "/api/check-article-update?action=core-version"
    },
    {
      "source": "/api/integrations",
      "destination": "/api/check-article-update?action=integrations"
    },
    {
      "source": "/api/suggest-target-keyword",
      "destination": "/api/check-article-update?action=suggest-target-keyword"
    },
    {
      "source": "/api/site-placeholders",
      "destination": "/api/check-article-update?action=site-placeholders"
    },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/audit-snapshot", "schedule": "0 9 * * *" }
  ]
}
